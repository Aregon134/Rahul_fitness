# ==========================================
# Local by Flywheel & Environment
# ==========================================
logs/
*.log
app/.envrc
.envrc
.env
.env.*
*.env
app/public/local-xdebuginfo.php
local-xdebuginfo.php

# ==========================================
# WordPress Cache, Upgrades & Backups
# ==========================================
app/public/wp-content/cache/
app/public/wp-content/upgrade/
app/public/wp-content/backups/
app/public/wp-content/backup-db/
app/public/wp-content/wflogs/
app/public/wp-content/advanced-cache.php
app/public/wp-content/wp-cache-config.php

# WordPress Media Uploads (prevents large binary bloat)
app/public/wp-content/uploads/*
!app/public/wp-content/uploads/.gitkeep
!app/public/wp-content/uploads/index.php

